# Copie este arquivo para .env.local e preencha os valores.
# Somente variáveis com prefixo VITE_ chegam ao navegador — NUNCA coloque aqui
# a service_role key do Supabase nem tokens do WhatsApp. Esses ficam apenas
# nas funções de backend (Etapas 3 e 6).

# URL pública do site (usada em canonical / Open Graph). Ex.: https://studionatallianjos.com.br
VITE_SITE_URL=

# Supabase (Etapa 3) — chaves públicas do projeto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (opcional). Deixe vazio para manter o rastreamento desligado.
VITE_META_PIXEL_ID=
